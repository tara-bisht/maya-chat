# Copy to apps/web/.env.local for local Next.js.
# Dev (local stack): http://127.0.0.1:54321 after `pnpm dlx supabase start`
# Stage: https://<stage-ref>.supabase.co
# Prod:  https://<prod-ref>.supabase.co

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Also used as OpenRouter HTTP-Referer (app attribution). Localhost needs OPENROUTER_API_KEY + this URL.

# Server only — never NEXT_PUBLIC_. Copy from Dashboard → API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Server only — never NEXT_PUBLIC_. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local Auth (`supabase start`) — Google Cloud OAuth Web client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
